PORT=5000
# Data is stored in backend/data/webtrack.json — no database server needed.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Open the panel directly without the login screen (login stays available
# at /login after a logout). Set to false to always require sign-in.
AUTO_LOGIN=true

# Seeded admin account (used by `npm run seed` and by auto-login on first run)
ADMIN_EMAIL=admin@webtrack.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin
