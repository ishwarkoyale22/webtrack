PORT=5000
CLIENT_URL=http://localhost:5173

# There is no login screen. The single admin profile (shown on invoices and
# in Settings) is created from these values on first run and by `npm run seed`.
ADMIN_EMAIL=admin@webtrack.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin

# ── Persistence ──────────────────────────────────────────────────────
# Leave the three FIREBASE_* vars below unset to use the local JSON file
# (backend/data/webtrack.json) — the default for local development.
#
# Set all three to switch to Firestore instead. This is REQUIRED in
# production on Vercel (or any serverless host) — Vercel's filesystem is
# ephemeral and per-instance, so the JSON file backend loses data there.
#
# Get these three values from Firebase Console → Project Settings →
# Service Accounts → Generate new private key (downloads a JSON file):
#   FIREBASE_PROJECT_ID   = the JSON file's "project_id"
#   FIREBASE_CLIENT_EMAIL = the JSON file's "client_email"
#   FIREBASE_PRIVATE_KEY  = the JSON file's "private_key" (keep the \n's
#                           literal — paste it exactly as it appears in
#                           the JSON string, quotes included)
# ── Supabase Integration ─────────────────────────────────────────────
# Fill these in to connect your Supabase PostgreSQL database.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
