PORT=5000
CLIENT_URL=http://localhost:5173

# There is no login screen. The single admin profile (shown on invoices and
# in Settings) is created from these values on first run and by `npm run seed`.
ADMIN_EMAIL=admin@webtrack.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin

# ── Persistence ──────────────────────────────────────────────────────
# Leave the two SUPABASE_* vars below unset to use the local JSON file
# (backend/data/webtrack.json) — the default for local development.
#
# Set both to switch to Supabase (Postgres) instead. This is REQUIRED in
# production on Vercel (or any serverless host) — Vercel's filesystem is
# ephemeral and per-instance, so the JSON file backend loses data there.
#
# Setup:
#   1. Run backend/store/supabase.sql in your Supabase project's SQL Editor
#      (creates the 8 tables this app needs — one per collection).
#   2. Supabase Dashboard → Project Settings → API:
#        SUPABASE_URL              = "Project URL"
#        SUPABASE_SERVICE_ROLE_KEY = "service_role" secret key
#      (NOT the "anon" key — the backend needs full read/write access,
#      which only the service_role key grants. Never expose this key to
#      the frontend or commit it.)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
